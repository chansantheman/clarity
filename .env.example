# Server-only AI Gateway authentication for local development.
AI_GATEWAY_API_KEY=
# Optional. Defaults to google/gemini-3.5-flash-lite
AI_COACH_MODEL=google/gemini-3.5-flash-lite
APP_VARIANT=development # LOCAL ONLY
EXPO_PUBLIC_AZURE_SPEECH_KEY=
EXPO_PUBLIC_AZURE_SPEECH_REGION=
# Set to 1 to send EAS Observe metrics from a debug build. Off by default, so
# dev-build noise stays out of the dashboard. No effect on release builds.
EXPO_PUBLIC_OBSERVE_IN_DEV=
